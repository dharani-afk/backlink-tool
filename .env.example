# Copy to .env.local for local development, and add the same names in Vercel > Project > Settings > Environment Variables.

# Postgres connection string (Neon, Supabase, or any Postgres). Leave empty locally to use the built-in dev database.
DATABASE_URL=

# Password the team types to open the dashboard. Make it long.
TEAM_PASSWORD=

# Long random strings. Generate each with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
RUNNER_TOKEN=
# Encrypts saved site passwords. Never change it after accounts exist, or saved passwords can no longer be read.
VAULT_KEY=
